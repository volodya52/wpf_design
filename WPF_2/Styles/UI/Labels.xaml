<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="OriginalLabel" TargetType="Label" BasedOn="{StaticResource MaterialDesignLabel}">
        <Setter Property="Foreground" Value="{StaticResource LabelsForeground}"/>
    </Style>


    <Style x:Key="InfoLabel" TargetType="Label" BasedOn="{StaticResource OriginalLabel}">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        
    </Style>

    <Style x:Key="PeoplesCount" TargetType="Label" BasedOn="{StaticResource OriginalLabel}">
        <Setter Property="Margin" Value="10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="NameLabel" TargetType="Label" BasedOn="{StaticResource OriginalLabel}">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="LabelID" TargetType="Label" BasedOn="{StaticResource OriginalLabel}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <Style x:Key="LabelPassword" TargetType="Label" BasedOn="{StaticResource OriginalLabel}">
        <Setter Property="Margin" Value="10,0,10,10"/>
    </Style>

    <Style x:Key="PacientsLabels" TargetType="Label" BasedOn="{StaticResource OriginalLabel}">
        <Setter Property="Height" Value="30"/>
        <Setter Property="Margin" Value="0,0,0,22"/>
    </Style>

</ResourceDictionary>